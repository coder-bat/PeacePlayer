# PeacePlayer backend — local environment template.
# Copy this file to backend/.env and fill in the values. The
# .env file itself is gitignored (see the root .gitignore).
#
# Generate a strong secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# and paste it below. The server refuses to boot if this is
# missing or shorter than 32 characters.

PEACEPLAYER_JWT_SECRET=

# Optional Apple Sign-In overrides (only needed for production
# Apple IDs — defaults work for the personal-use build):
# APPLE_TEAM_ID=
# APPLE_BUNDLE_ID=
